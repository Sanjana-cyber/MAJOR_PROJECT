<% layout('/layout/boilerplate') -%>
<form   method="POST"action="/listing/<%= detail._id %>/update?_method=PUT">
    <input type="text"name="listing[title]" value="<%=detail.title%>">
    <br><br>
    <textarea name="listing[description]" > <%=detail.description%></textarea>
    <br><br>
     <input type="number"name="listing[price]" value="<%=detail.price%>">
    <br><br>
     <input type="text"name="listing[location]" value="<%=detail.location%>">
    <br><br>
    
     <input type="text"name="listing[country]"  value="<%=detail.country%>">
    <br><br>

    <button> SUBMIT</button>
   </form>
   </BODY>
