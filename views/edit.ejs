<% layout('/layout/boilerplate') -%>

<div class="create-listing-page">

    <div class="create-listing-form">

        <h2>Edit Listing</h2>
        <p class="form-subtitle">Update the details of your property</p>

        <form method="POST" action="/listing/<%= detail._id %>/update?_method=PUT" class="needs-validation" novalidate>

            <!-- Title -->

            <div class="mb-3">
                <label for="title" class="form-label">
                    Title <span class="required-star">*</span>
                </label>

                <input
                    type="text"
                    class="form-control"
                    id="title"
                    name="listing[title]"
                    value="<%= detail.title %>"
                    required
                >

                <div class="invalid-feedback">
                    Please enter the detail
                </div>
            </div>


            <!-- Description -->

            <div class="mb-3">
                <label for="description" class="form-label">
                    Description <span class="required-star">*</span>
                </label>

                <textarea
                    class="form-control"
                    id="description"
                    name="listing[description]"
                    rows="4"
                    required
                ><%= detail.description %></textarea>

                <div class="invalid-feedback">
                    Please enter the detail
                </div>
            </div>


            <!-- Price -->

            <div class="mb-3">
                <label for="price" class="form-label">
                    Price <span class="required-star">*</span>
                </label>

                <div class="input-group">

                    <span class="input-group-text">&#8377;</span>

                    <input
                        type="number"
                        class="form-control"
                        id="price"
                        name="listing[price]"
                        value="<%= detail.price %>"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter the detail
                    </div>

                </div>
            </div>


            <!-- Location + Country -->

            <div class="location-country">

                <div>
                    <label for="location" class="form-label">
                        Location <span class="required-star">*</span>
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="location"
                        name="listing[location]"
                        value="<%= detail.location %>"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter the detail
                    </div>
                </div>


                <div>
                    <label for="country" class="form-label">
                        Country <span class="required-star">*</span>
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        id="country"
                        name="listing[country]"
                        value="<%= detail.country %>"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter the detail
                    </div>
                </div>

            </div>


            <!-- Submit -->

            <button type="submit" class="add-listing-btn">
                UPDATE
            </button>

        </form>

    </div>

</div>
```
