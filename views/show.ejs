<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h3> HERE IS THE DETAIL OF YOUR DATA</h3>
    <ul>
        <li>
        <%= detail.title%>
        </li>
          <li>
        <%= detail.description%>
        </li>
         <li >&#8377;
        <%= detail.price.toLocaleString("en-IN")%>
        </li>
         <li>
        <%= detail.location%>
        </li>
         <li>
        <%= detail.country%>
        </li>
    </ul>
   <form  method="GET" action="/listing/<%= detail._id%>/edit">
     <button>
    EDIT
   </button>

  </form>
  <br>
  <form   method="POST"action="/listing/<%= detail._id %>?_method=DELETE">
    <button>
    DELETE
   </button>
  </form>
</body>
</html>